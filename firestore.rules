rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: orders
// Document ID: order number, e.g. "ES-261120-4F09A2" (^ES-\d{6}-[0-9A-F]{6}$)
// Fields (see shared/types/orders.ts, StoredOrder; written by server/api/orders.post.ts):
//   - number: string (required, immutable) - same as the document ID
//   - createdAt: string (required, immutable, ISO 8601) - when the order was placed
//   - status: string (required, one of new|processing|shipped|delivered|cancelled)
//   - statusHistory: list<map{status: string, at: string, notification?: string}> (required)
//   - locale: string (required, "pl" | "en")
//   - customer: map (required, PII) - name, email, phone, street, postalCode,
//       city, notes, payment
//   - items: list<map{id, name, size, quantity, unitPrice, total}> (required)
//   - subtotal, shipping, total: number (required, >= 0)
//   - currency: string (required, "PLN")
//   - terms: map{version: string, acceptedAt: string} (optional)
//
// Collection: mail
// Document ID: auto-generated
// Fields (see server/utils/mailer.ts and functions/deliver.js):
//   - to: map{name: string, address: string} (required, PII)
//   - subject, text, html: string (required) - rendered customer email
//   - orderNumber: string (required) - order the email belongs to
//   - historyAt: string (required) - status-history entry to update
//   - createdAt: timestamp (required)
//   - expireAt: timestamp (required) - TTL policy deletes the document after 30 days
//   - attempts: number (required, >= 0)
//   - delivery: map{state: PENDING|SENDING|RETRY|SENT|FAILED, leaseUntil?, error?, at?}
//
// Collection: products
// Document ID: URL-safe slug, e.g. "knitted-poncho"
// Fields (see app/utils/products.ts, ProductDoc, and scripts/seed-products.mjs):
//   - name: map{pl: string, en: string} (required, each 1-120 chars)
//   - description: map{pl: string, en: string} (required, each 0-2000 chars)
//   - price: number (required, > 0 and < 100000) - price in PLN
//   - category: string (required, one of women|men|accessories)
//   - image: string (required, https URL, max 500 chars)
//   - sizes: list<string> (required, 1-12 items, each one of XS|S|M|L|XL|XXL|
//       ONE|44|46|48|50|52|54|56) - "ONE" means one size fits all
//   - createdAt: timestamp (required) - used for "newest" sorting
//   Contains NO personal or private data: everything in this collection is
//   public catalogue content. Never add cost prices, stock suppliers or other
//   internal fields here, because any visitor can read every document.
//
// Access pattern:
//   Products are the public shop catalogue. The website reads them directly
//   from the browser and during server rendering (unauthenticated Firebase
//   client SDK), optionally filtered with where('category', '==', ...).
//   Nobody may write them from a client: the catalogue is managed with the
//   Admin SDK (scripts/seed-products.mjs) or the Firebase console.
//
//   Orders and queued emails contain customers' personal data and are read
//   and written ONLY by the shop's server (App Hosting) and the
//   sendQueuedMail Cloud Function, both through the Firebase Admin SDK, which
//   is not subject to these rules. The browser never reads or writes
//   them, so every client access to orders and mail is denied.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    // Kept for when client access is added in the future. They are not used
    // by any rule below, because all client access is currently denied.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Domain validator for orders. Unused: clients may not create or update
    // orders. Writes happen only on the server, which validates them itself.
    function isValidOrder(data) {
      return data.keys().hasAll(['number', 'createdAt', 'status', 'statusHistory', 'locale',
                                 'customer', 'items', 'subtotal', 'shipping', 'total', 'currency']) &&
        data.keys().hasOnly(['number', 'createdAt', 'status', 'statusHistory', 'locale',
                             'customer', 'items', 'subtotal', 'shipping', 'total', 'currency', 'terms']) &&
        data.number is string && data.number.size() <= 20 &&
        data.status in ['new', 'processing', 'shipped', 'delivered', 'cancelled'] &&
        data.locale in ['pl', 'en'] &&
        data.items is list && data.items.size() <= 50 &&
        data.total is number && data.total >= 0 &&
        data.currency == 'PLN';
    }

    function isValidLocalizedText(text, minLen, maxLen) {
      return text is map &&
        text.keys().hasAll(['pl', 'en']) && text.keys().hasOnly(['pl', 'en']) &&
        text.pl is string && text.pl.size() >= minLen && text.pl.size() <= maxLen &&
        text.en is string && text.en.size() >= minLen && text.en.size() <= maxLen;
    }

    // Domain validator for products. Unused: clients may not create or update
    // products. Kept so the schema is enforced if admin client writes are
    // ever allowed (call it in BOTH create and update).
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'description', 'price', 'category', 'image', 'sizes', 'createdAt']) &&
        data.keys().hasOnly(['name', 'description', 'price', 'category', 'image', 'sizes', 'createdAt']) &&
        data.sizes is list && data.sizes.size() >= 1 && data.sizes.size() <= 12 &&
        data.sizes.hasOnly(['XS', 'S', 'M', 'L', 'XL', 'XXL', 'ONE', '44', '46', '48', '50', '52', '54', '56']) &&
        isValidLocalizedText(data.name, 1, 120) &&
        isValidLocalizedText(data.description, 0, 2000) &&
        data.price is number && data.price > 0 && data.price < 100000 &&
        data.category in ['women', 'men', 'accessories'] &&
        data.image is string && data.image.size() <= 500 && data.image.matches('^https://.*') &&
        data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Products: public catalogue. Anyone (signed in or not) may read and
    // query it, as explicitly requested for the shop's product listing.
    // All client writes are denied; manage products with the Admin SDK.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders: server only (Admin SDK). No client may read, list, create,
    // update or delete them.
    match /orders/{orderNumber} {
      allow read, write: if false;
    }

    // Mail queue: server and Cloud Function only (Admin SDK).
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Anything else: denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

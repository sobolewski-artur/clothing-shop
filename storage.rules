rules_version = '2';

// ===============================================================
// Assumed data model
// ===============================================================
//
// products/{uuid}.{jpg|png|webp|avif} - product photos
//   Uploaded only by the shop's server (POST /api/admin/uploads, admins only)
//   through the Firebase Admin SDK, which is not subject to these rules.
//   Each file gets a download token, and the shop shows it through its
//   token URL (https://firebasestorage.googleapis.com/...&token=...), which
//   also works without any read rule.
//
// Access pattern: no browser ever reads or writes the bucket directly, so
// every client request is denied.
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

# Settings for the "mail" Cloud Functions codebase. Copy to .env (git-ignored) and fill in.
# The SMTP password is NOT set here: it lives in Cloud Secret Manager
#   pnpm dlx firebase-tools@latest functions:secrets:set SMTP_PASSWORD
SMTP_HOST=smtp-relay.brevo.com
# 587 = STARTTLS (SMTP_SECURE=false); 465 = TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
# Brevo: the SMTP login from Settings → SMTP & API (e.g. 1234567@smtp-brevo.com)
SMTP_USER=
MAIL_FROM=Clothing Store <shop@your-domain.com>
